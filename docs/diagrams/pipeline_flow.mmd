flowchart TB
  subgraph IN["Sensor input"]
    direction LR
    IMG["Image"]
    SCN["LaserScan /scan"]
  end

  SYN["ApproximateTime sync<br/>image + laser"]

  subgraph LID["Pipeline LiDAR — dynamic_tracking_node"]
    direction TB
    SEG["segment_scan<br/>jump-distance 1x"]
    DET["Parallel detectors<br/>RF · AdaBoost · heuristic · blob"]
    FUS["fusion<br/>max_score / require_two"]
    FLT["Filters<br/>/map + costmap"]
    TRK["Kalman + Hungarian<br/>laser-only position"]
  end

  subgraph YO["Auxiliary YOLO — metadata"]
    direction TB
    YD["YOLO background thread"]
    YA["person confirmation<br/>bbox · RViz colour"]
  end

  subgraph OUT["ROS outputs"]
    direction LR
    MK["/dynamic_tracks_markers<br/>tracks RViz"]
    DT["/detections/tracked"]
    AN["/image_annotated"]
  end

  IMG --> SYN
  SCN --> SYN
  SYN --> SEG
  SEG --> DET --> FUS --> FLT --> TRK
  SYN --> YD --> YA
  YA -. "no correct Kalman" .-> TRK
  TRK --> MK
  TRK --> DT
  YA --> AN

  classDef input fill:#dbeafe,stroke:#2563eb,color:#0f172a
  classDef lidar fill:#dcfce7,stroke:#16a34a,color:#0f172a
  classDef yolo fill:#fef3c7,stroke:#d97706,color:#0f172a
  classDef out fill:#f3e8ff,stroke:#7c3aed,color:#0f172a
  class IMG,SCN input
  class SEG,DET,FUS,FLT,TRK lidar
  class YD,YA yolo
  class MK,DT,AN out
